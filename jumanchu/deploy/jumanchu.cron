# =====================================================================
#  주만추 배치 crontab — Linux 배포 서버용
# =====================================================================
#  설치:
#    1) 아래 BACKEND / PY 경로를 실제 배포 경로로 치환
#    2) 로그 디렉토리 생성:  sudo mkdir -p /var/log/jumanchu && sudo chown $USER /var/log/jumanchu
#    3) 등록:  crontab deploy/jumanchu.cron      (확인: crontab -l)
#
#  ⚠️ 전제: DB(Postgres)·Redis가 떠 있어야 배치가 동작한다.
#  ⚠️ TZ: 아래 TZ=Asia/Seoul 로 cron 실행 시각을 KST 기준으로 고정한다(서버 TZ와 무관).
#  ⚠️ 동시 실행 방지: flock -n 으로 이전 실행이 안 끝났으면 이번 건 건너뛴다(중복 적재 차단).
#  ⚠️ warm_volume_loop 는 30초 주기라 cron(분 단위) 부적합 → @reboot 로 상시 띄운다.
#       더 견고하게는 systemd 서비스 권장(파일 하단 예시 참고).
#  ⚠️ 공휴일 미고려: _is_market_open 이 공휴일을 모른다(휴장일에도 daily 가 돈다).
#       daily 는 멱등(같은 날 재적재 무해)이라 큰 문제는 아니나, 인지해 둘 것.
# =====================================================================

TZ=Asia/Seoul
BACKEND=/opt/jumanchu/backend
PY=/usr/bin/python
LOG=/var/log/jumanchu

# ─ 데이터 적재 배치 (run_batch 오케스트레이터) ─────────────────────────
#  분 시 일 월 요일   명령
# 평일 18:10 — 가격→지표→DNA→장투점수 (장 마감 후)
10 18 * * 1-5  cd $BACKEND && flock -n /tmp/jumanchu-daily.lock  $PY manage.py run_batch daily  >> $LOG/daily.log  2>&1
# 일요일 04:00 — 마스터·메타·재무
0  4  * * 0    cd $BACKEND && flock -n /tmp/jumanchu-weekly.lock $PY manage.py run_batch weekly >> $LOG/weekly.log 2>&1
# 매시 정각 — 뉴스 수집
0  *  * * *    cd $BACKEND && flock -n /tmp/jumanchu-hourly.lock $PY manage.py run_batch hourly >> $LOG/hourly.log 2>&1

# ─ 실시간 워머 (장중 ~30초 루프) ──────────────────────────────────────
#  cron 으로는 30초 못 함 → 부팅 시 백그라운드 상시 기동. 죽으면 다음 부팅까지 안 뜸(아래 systemd 권장).
@reboot        cd $BACKEND && $PY manage.py warm_volume_loop >> $LOG/volwarmer.log 2>&1 &

# =====================================================================
#  (권장) warm_volume_loop 를 systemd 서비스로 — 죽으면 자동 재시작
#  /etc/systemd/system/jumanchu-volwarmer.service :
#
#    [Unit]
#    Description=Jumanchu volume-power warmer (장중 30s 루프)
#    After=network-online.target redis.service postgresql.service
#
#    [Service]
#    WorkingDirectory=/opt/jumanchu/backend
#    ExecStart=/usr/bin/python manage.py warm_volume_loop
#    Restart=always
#    RestartSec=5
#    Environment=TZ=Asia/Seoul
#    User=jumanchu
#
#    [Install]
#    WantedBy=multi-user.target
#
#  등록:  sudo systemctl daemon-reload && sudo systemctl enable --now jumanchu-volwarmer
#  이 경우 위 @reboot 줄은 제거한다.
# =====================================================================
