# 팀원용 환경 변수 템플릿.
# git clone 후 `cp .env.example .env` 하고 비밀 값들을 채워 사용하세요.
# 실제 .env 는 절대 커밋 금지.

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL via docker-compose)
# DB_ENGINE=sqlite uses backend/db.sqlite3 for quick local runserver.
# Leave DB_ENGINE empty and set DB_PASSWORD to use PostgreSQL.
DB_ENGINE=sqlite
SQLITE_DB_NAME=db.sqlite3
DB_NAME=jumanchu
DB_USER=jumanchu
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# External APIs
KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=
BIGKINDS_API_KEY=
OPENAI_API_KEY=
GNews_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
